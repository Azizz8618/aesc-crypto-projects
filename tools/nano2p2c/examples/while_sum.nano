fn sum_to(n: int) -> int {
    let mut total: int = 0
    let mut i: int = 1
    while (<= i n) {
        set total (+ total i)
        set i (+ i 1)
    }
    return total
}

shadow sum_to {
    assert (== (sum_to 0) 0)
    assert (== (sum_to 5) 15)
}

fn main() -> int {
    (println (sum_to 5))
    return 0
}

shadow main {
    assert true
}
